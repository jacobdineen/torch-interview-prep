{
  "name": "alphazero-connect4",
  "title": "AlphaZero on Connect-4 from Scratch",
  "parts": [
    {
      "title": "Connect-4 Game Engine",
      "description": "Board representation, move mechanics, terminal detection, and the env step function."
    },
    {
      "title": "Board Encoding and Policy-Value Network",
      "description": "Encode boards as tensors and a conv backbone with policy and value heads."
    },
    {
      "title": "Action Masking and Policy Sampling",
      "description": "Mask illegal moves and turn logits into sampled or greedy column actions."
    },
    {
      "title": "PUCT Monte Carlo Tree Search",
      "description": "Nodes, PUCT selection, network-guided expansion, backup, and full MCTS rollouts."
    },
    {
      "title": "Self-Play Data Generation",
      "description": "MCTS self-play recording (state, policy, outcome) training tuples."
    },
    {
      "title": "Losses and Training Loop",
      "description": "Policy, value, and L2 losses and minibatched training over the self-play buffer."
    },
    {
      "title": "Iterated Training Loop",
      "description": "Alternate self-play generation and network training across iterations."
    },
    {
      "title": "Agents and Evaluation",
      "description": "Baseline agents, head-to-head matches, and win rate against a random policy."
    }
  ],
  "steps": [
    {
      "id": "0001",
      "name": "make_empty_board",
      "part": 0,
      "points": 10,
      "signature": "make_empty_board()",
      "doc": "A fresh 6x7 board of zeros."
    },
    {
      "id": "0002",
      "name": "column_top_row",
      "part": 0,
      "points": 10,
      "signature": "column_top_row(board, col)",
      "doc": "Row index a dropped piece would land in (lowest empty row), or -1 if full."
    },
    {
      "id": "0003",
      "name": "column_full",
      "part": 0,
      "points": 10,
      "signature": "column_full(board, col)",
      "doc": "True if a column has no empty cell."
    },
    {
      "id": "0004",
      "name": "valid_moves",
      "part": 0,
      "points": 10,
      "signature": "valid_moves(board)",
      "doc": "List of columns that are not full."
    },
    {
      "id": "0005",
      "name": "drop_piece",
      "part": 0,
      "points": 10,
      "signature": "drop_piece(board, col, player)",
      "doc": "Return a NEW board with ``player``'s piece dropped into ``col``."
    },
    {
      "id": "0006",
      "name": "four_in_a_row_horizontal",
      "part": 0,
      "points": 10,
      "signature": "four_in_a_row_horizontal(board, player)",
      "doc": "True if ``player`` has four consecutive pieces in any row."
    },
    {
      "id": "0007",
      "name": "four_in_a_row_vertical",
      "part": 0,
      "points": 10,
      "signature": "four_in_a_row_vertical(board, player)",
      "doc": "True if ``player`` has four consecutive pieces in any column."
    },
    {
      "id": "0008",
      "name": "four_in_a_row_diagonal_down_right",
      "part": 0,
      "points": 10,
      "signature": "four_in_a_row_diagonal_down_right(board, player)",
      "doc": "True if ``player`` has four in a row along a down-right (\\) diagonal."
    },
    {
      "id": "0009",
      "name": "four_in_a_row_diagonal_up_right",
      "part": 0,
      "points": 10,
      "signature": "four_in_a_row_diagonal_up_right(board, player)",
      "doc": "True if ``player`` has four in a row along an up-right (/) diagonal."
    },
    {
      "id": "0010",
      "name": "check_winner",
      "part": 0,
      "points": 10,
      "signature": "check_winner(board)",
      "doc": "Return the winning player (+1 / -1), or 0 if there is no winner."
    },
    {
      "id": "0011",
      "name": "board_is_full",
      "part": 0,
      "points": 10,
      "signature": "board_is_full(board)",
      "doc": "True if there are no empty cells."
    },
    {
      "id": "0012",
      "name": "is_terminal",
      "part": 0,
      "points": 10,
      "signature": "is_terminal(board)",
      "doc": "True if the game is over (someone won or the board is full)."
    },
    {
      "id": "0013",
      "name": "other_player",
      "part": 0,
      "points": 10,
      "signature": "other_player(player)",
      "doc": "The opponent of ``player``."
    },
    {
      "id": "0014",
      "name": "step_env",
      "part": 0,
      "points": 10,
      "signature": "step_env(board, col, player)",
      "doc": "Apply ``player``'s move in ``col``. Returns (next_board, reward, done) where\nreward is +1 if this move wins for ``player``, else 0."
    },
    {
      "id": "0015",
      "name": "encode_board",
      "part": 1,
      "points": 10,
      "signature": "encode_board(board, player)",
      "doc": "Two planes from ``player``'s perspective: [my pieces, opponent pieces].\nShape (2, 6, 7), float."
    },
    {
      "id": "0016",
      "name": "board_to_torch_tensor",
      "part": 1,
      "points": 10,
      "signature": "board_to_torch_tensor(encoded)",
      "doc": "Turn an encoded board into a batched float tensor (1, C, 6, 7)."
    },
    {
      "id": "0017",
      "name": "init_conv_backbone",
      "part": 1,
      "points": 10,
      "signature": "init_conv_backbone(in_channels, hidden)",
      "doc": "A small conv backbone preserving the 6x7 spatial size."
    },
    {
      "id": "0018",
      "name": "init_policy_head",
      "part": 1,
      "points": 10,
      "signature": "init_policy_head(input_dim, n_actions)",
      "doc": "Linear policy head over the flattened features -> action logits."
    },
    {
      "id": "0019",
      "name": "init_value_head",
      "part": 1,
      "points": 10,
      "signature": "init_value_head(input_dim)",
      "doc": "Value head -> a scalar in [-1, 1] via tanh."
    },
    {
      "id": "0020",
      "name": "build_policy_value_net",
      "part": 1,
      "points": 10,
      "signature": "build_policy_value_net(in_channels=2, hidden=32, n_actions=7)",
      "doc": "Assemble the conv backbone + policy and value heads into one module whose\nforward(x) returns (policy_logits (B, n_actions), value (B,))."
    },
    {
      "id": "0021",
      "name": "policy_value_forward",
      "part": 1,
      "points": 10,
      "signature": "policy_value_forward(net, x)",
      "doc": "Run the network: returns (policy_logits, value)."
    },
    {
