{
  "name": "rlhf-distilgpt2",
  "title": "RLHF from Scratch on DistilGPT2",
  "parts": [
    {
      "title": "Model Setup and Decoding Strategies",
      "description": "Load distilgpt2, sanity-check generation, and implement greedy/temperature/top-k/top-p decoding."
    },
    {
      "title": "SFT Data Pipeline",
      "description": "A synthetic instruction dataset plus formatting, tokenization, label masking, padding, batching, splits."
    },
    {
      "title": "SFT Training Loop",
      "description": "Shifted next-token loss, AdamW, warmup, grad clipping, accumulation, train/eval steps."
    },
    {
      "title": "LoRA Adapters",
      "description": "Low-rank adapters: the LoRA delta, forward, init, freezing, counting, and merge-back."
    },
    {
      "title": "Reward Modeling",
      "description": "A synthetic preference dataset and a reward head with pairwise / BCE losses and accuracy."
    },
    {
      "title": "PPO-Based RLHF",
      "description": "PPO ingredients: log-probs, KL penalty, returns, GAE, clipped surrogate, value loss, entropy, ppo_loss."
    },
    {
      "title": "Preference Optimization Alternatives",
      "description": "Reference-based and reference-free preference losses: DPO, IPO, KTO, ORPO, SimPO."
    },
    {
      "title": "Evaluation and Chat Interface",
      "description": "Held-out generation, reward scoring, win rate, token streaming, stop-token handling, and chat."
    }
  ],
  "steps": [
    {
      "id": "0001",
