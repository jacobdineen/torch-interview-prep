{
  "name": "tiny-gpt-from-scratch",
  "title": "Tiny GPT From Scratch",
  "parts": [
    {
      "title": "Tokenizer",
      "description": "Build a tiny character-level tokenizer with vocab, stoi/itos, and encode/decode helpers."
    },
    {
      "title": "NumPy and Softmax Foundations",
      "description": "Get fluent with NumPy arrays, indexing, broadcasting, reductions, and numerically stable softmax."
    },
    {
      "title": "Data Pipeline and Bigram Baseline",
      "description": "Load the corpus, build batched (X, Y) sequences, and train a counting-based bigram model."
    },
    {
      "title": "Single-Layer Neural Bigram",
      "description": "Replace the count table with a learned weight matrix; derive cross-entropy, gradients, SGD."
    },
    {
      "title": "Layer Primitives and Backprop",
      "description": "Forward and backward for linear, bias, ReLU, softmax+CE, and LayerNorm building blocks."
    },
    {
      "title": "Embeddings and Self-Attention",
      "description": "Token/positional embeddings, then masked single- and multi-head self-attention with backward."
    },
    {
      "title": "FFN, Blocks, and Full Model",
      "description": "Feed-forward, residuals, pre-LN Transformer blocks, and the complete GPT forward/backward."
    },
    {
      "title": "Adam, Training Loop, and Generation",
      "description": "Adam, the full training/validation loop, and sampling with temperature and top-k decoding."
    }
  ],
