{
  "name": "tic-tac-toe-rl",
  "title": "Reinforcement Learning for Tic-Tac-Toe: From Minimax to DQN",
  "parts": [
    {
      "title": "Board Representation & Game Engine",
      "description": "Encode the 3x3 board, move legality, win/draw detection, turn tracking, and a Game class."
    },
    {
      "title": "Random and Minimax Baselines",
      "description": "A random agent, head-to-head rollouts, and full minimax with alpha-beta pruning."
    },
    {
      "title": "Tabular Q-Learning Foundations",
      "description": "State hashing with symmetry, hyperparameters, epsilon-greedy, rewards, and the Q-update loop."
    },
    {
      "title": "Self-Play, Evaluation & Persistence",
      "description": "Self-play with perspective flipping, evaluation vs random/minimax, and Q-table save/load."
    },
    {
      "title": "Deep Q-Network Agent",
      "description": "Board encodings, an MLP with backprop, replay buffer, target network, and DQN training."
    },
    {
      "title": "Policy Gradients & Extensions",
      "description": "SARSA, REINFORCE, value-vs-policy comparison, and 8-fold symmetry data augmentation."
    }
  ],
  "steps": [
    {
      "id": "0001",
      "name": "create_empty_board",
      "part": 0,
      "points": 5,
      "signature": "create_empty_board()",
      "doc": "A fresh 3x3 board of zeros (all cells empty)."
    },
    {
      "id": "0002",
      "name": "encode_player",
      "part": 0,
      "points": 5,
      "signature": "encode_player(symbol)",
      "doc": "Map a player symbol to its board mark: 'X' -> +1, 'O' -> -1."
    },
    {
      "id": "0003",
      "name": "print_board",
      "part": 0,
      "points": 5,
      "signature": "print_board(board)",
      "doc": "Render the board as a string using X / O / . , rows on separate lines."
    },
    {
      "id": "0004",
      "name": "is_cell_empty",
      "part": 0,
      "points": 5,
      "signature": "is_cell_empty(board, action)",
      "doc": "True if the cell at action 0..8 is empty."
    },
    {
      "id": "0005",
      "name": "place_move",
      "part": 0,
      "points": 5,
      "signature": "place_move(board, action, player)",
      "doc": "Return a NEW board with ``player``'s mark placed at ``action`` (no mutation)."
    },
    {
      "id": "0006",
      "name": "get_legal_moves",
      "part": 0,
      "points": 5,
      "signature": "get_legal_moves(board)",
      "doc": "List of empty action indices (0..8)."
    },
    {
      "id": "0007",
      "name": "check_row_win",
      "part": 0,
      "points": 5,
      "signature": "check_row_win(board, player)",
      "doc": "True if ``player`` occupies a full row."
    },
    {
      "id": "0008",
      "name": "check_column_win",
      "part": 0,
      "points": 5,
      "signature": "check_column_win(board, player)",
      "doc": "True if ``player`` occupies a full column."
    },
    {
      "id": "0009",
      "name": "check_main_diagonal_win",
      "part": 0,
      "points": 5,
      "signature": "check_main_diagonal_win(board, player)",
      "doc": "True if ``player`` occupies the main (top-left to bottom-right) diagonal."
    },
    {
      "id": "0010",
      "name": "check_anti_diagonal_win",
      "part": 0,
      "points": 5,
      "signature": "check_anti_diagonal_win(board, player)",
      "doc": "True if ``player`` occupies the anti (top-right to bottom-left) diagonal."
    },
    {
      "id": "0011",
      "name": "is_winner",
      "part": 0,
      "points": 5,
      "signature": "is_winner(board, player)",
      "doc": "True if ``player`` has any winning line (row, column, or diagonal)."
    },
    {
      "id": "0012",
      "name": "is_draw",
      "part": 0,
      "points": 5,
      "signature": "is_draw(board)",
      "doc": "True if the board is full and neither player has won."
    },
    {
      "id": "0013",
      "name": "get_game_status",
      "part": 0,
      "points": 5,
      "signature": "get_game_status(board)",
      "doc": "Game outcome: +1 (X wins), -1 (O wins), 0 (draw), or None (still in play)."
    },
    {
      "id": "0014",
      "name": "get_current_player",
      "part": 0,
      "points": 5,
      "signature": "get_current_player(board)",
      "doc": "Whose turn it is: +1 if X and O have played equally (X starts), else -1."
    },
    {
      "id": "0015",
      "name": "switch_player",
      "part": 0,
      "points": 5,
      "signature": "switch_player(player)",
      "doc": "The other player: +1 <-> -1."
    },
    {
      "id": "0016",
      "name": "play_hardcoded_game",
      "part": 0,
      "points": 5,
      "signature": "play_hardcoded_game(moves)",
      "doc": "Play a fixed list of actions, alternating from X, and return the final board."
    },
    {
      "id": "0017",
      "name": "play_interactive_game",
      "part": 0,
      "points": 5,
      "signature": "play_interactive_game(get_move)",
      "doc": "Play to termination, asking ``get_move(board, player)`` for each action.\nReturns the final game status (+1 / -1 / 0). ``get_move`` makes this testable\nwithout real stdin (pass a scripted callback)."
    },
    {
      "id": "0018",
      "name": "TicTacToeGame",
      "part": 0,
      "points": 5,
      "signature": "TicTacToeGame()",
      "doc": "A reusable game object wrapping the functional engine.\n\nAttributes: ``board`` (3x3) and ``current_player`` (+1/-1).\nMethods: reset(), legal_moves(), step(action) -> status, status()."
    },
    {
      "id": "0019",
      "name": "random_move_agent",
      "part": 1,
      "points": 5,
      "signature": "random_move_agent(board, rng)",
      "doc": "Pick a uniformly random legal action using ``rng`` (a numpy Generator)."
    },
    {
      "id": "0020",
      "name": "play_random_vs_random_game",
      "part": 1,
      "points": 5,
      "signature": "play_random_vs_random_game(rng)",
      "doc": "Play one game with both sides random; return the final status (+1/-1/0)."
    },
    {
      "id": "0021",
      "name": "play_random_vs_random_matches",
      "part": 1,
      "points": 5,
      "signature": "play_random_vs_random_matches(n_games, rng)",
      "doc": "Play ``n_games`` random-vs-random games; return the list of statuses."
    },
    {
      "id": "0022",
      "name": "compute_outcome_rates",
      "part": 1,
      "points": 5,
      "signature": "compute_outcome_rates(statuses)",
      "doc": "Fraction of X wins / O wins / draws from a list of statuses."
    },
    {
      "id": "0023",
      "name": "minimax_terminal_score",
      "part": 1,
      "points": 5,
      "signature": "minimax_terminal_score(board)",
      "doc": "Score of a terminal board from X's perspective: +1 X win, -1 O win, 0 draw."
    },
    {
      "id": "0024",
      "name": "minimax_recursive",
      "part": 1,
      "points": 5,
      "signature": "minimax_recursive(board, player)",
      "doc": "Exact minimax value of ``board`` with ``player`` to move (X maximizes). Uses\na transposition table (positions reachable many ways are scored once)."
    },
    {
      "id": "0025",
      "name": "minimax_max_min_step",
      "part": 1,
      "points": 5,
      "signature": "minimax_max_min_step(player, values)",
      "doc": "Combine child values: the maximizer (X, +1) takes max, the minimizer (O) min."
    },
    {
      "id": "0026",
      "name": "minimax_best_move",
      "part": 1,
      "points": 5,
      "signature": "minimax_best_move(board, player)",
      "doc": "The action with the optimal minimax value for ``player`` (first if tied).\nScores all candidate moves with one shared transposition table."
    },
    {
      "id": "0027",
      "name": "minimax_alpha_beta",
      "part": 1,
      "points": 5,
      "signature": "minimax_alpha_beta(board, player, alpha, beta)",
      "doc": "Minimax value with alpha-beta pruning (same result as minimax_recursive)."
    },
    {
      "id": "0028",
      "name": "play_minimax_vs_random_matches",
      "part": 1,
      "points": 5,
      "signature": "play_minimax_vs_random_matches(n_games, rng)",
      "doc": "Minimax (X) vs random (O). Minimax should never lose; returns statuses.\nMove selection uses alpha-beta (same as minimax, just faster)."
    },
    {
      "id": "0029",
      "name": "play_minimax_vs_minimax_matches",
      "part": 1,
      "points": 5,
      "signature": "play_minimax_vs_minimax_matches(n_games)",
      "doc": "Minimax vs minimax \u2014 always a draw with optimal play; returns statuses."
    },
